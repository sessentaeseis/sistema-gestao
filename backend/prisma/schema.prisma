// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id     Int     @id @default(autoincrement())
  nome   String
  email  String  @unique
  senha  String
  cpf    String     @unique

  listas  ListaTarefas[]
  tarefas Tarefa[]
  sessoes Sessao[]
}

model ListaTarefas {
  id          Int      @id @default(autoincrement())
  nome        String
  descricao   String?
  criada_em   DateTime @default(now())

  criador_id  Int
  criador     Usuario  @relation(fields: [criador_id], references: [id])

  tarefas     Tarefa[]
}

model Tarefa {
  id              Int          @id @default(autoincrement())
  titulo          String
  descricao       String?
  status          String       @default("PENDENTE")
  criada_em       DateTime     @default(now())
  prazo           DateTime

  lista_id        Int
  lista           ListaTarefas @relation(fields: [lista_id], references: [id])

  responsavel_id  Int
  responsavel     Usuario      @relation(fields: [responsavel_id], references: [id])
}

model Sessao {
  id            Int       @id @default(autoincrement())
  token   String    @unique
  criada_em     DateTime  @default(now())
  expira_em     DateTime
  encerrada_em  DateTime?

  usuario_id    Int
  usuario       Usuario   @relation(fields: [usuario_id], references: [id])
}